{
  "openapi": "3.0.0",
  "info": {
    "title": "Pome API",
    "version": "2.0.0",
    "description": "API for Pome dermatology treatment discovery platform. Browse treatments, find clinics, save favorites, and search for cosmetic procedures in Korea."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "Treatments",
      "description": "Browse and search cosmetic treatments"
    },
    {
      "name": "Clinics",
      "description": "Find and explore dermatology clinics"
    },
    {
      "name": "Search",
      "description": "Search across treatments and clinics"
    },
    {
      "name": "Saved Items",
      "description": "Manage saved treatments and clinics"
    }
  ],
  "paths": {
    "/treatments": {
      "get": {
        "tags": ["Treatments"],
        "summary": "List all treatments",
        "description": "Get a paginated list of cosmetic treatments with optional filtering by categories and price range",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "categories",
            "in": "query",
            "description": "Comma-separated list of categories to filter by",
            "schema": {
              "type": "string"
            },
            "example": "anti-aging,skin-rejuvenation"
          },
          {
            "name": "priceMin",
            "in": "query",
            "description": "Minimum price in KRW",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "priceMax",
            "in": "query",
            "description": "Maximum price in KRW",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "treatments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Treatment"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/treatments/{id}": {
      "get": {
        "tags": ["Treatments"],
        "summary": "Get treatment by ID",
        "description": "Retrieve detailed information about a specific treatment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Treatment ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "treatment": {
                      "$ref": "#/components/schemas/Treatment"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/treatments/{id}/clinics": {
      "get": {
        "tags": ["Treatments"],
        "summary": "Get clinics offering a treatment",
        "description": "Retrieve all clinics that offer a specific treatment, including pricing and availability",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Treatment ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "clinics": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Clinic"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "price": {
                                "type": "integer",
                                "description": "Price for this treatment at this clinic"
                              },
                              "availability": {
                                "type": "string",
                                "description": "Availability status"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/clinics": {
      "get": {
        "tags": ["Clinics"],
        "summary": "List all clinics",
        "description": "Get a paginated list of dermatology clinics with optional filtering by location, verified status, and specialties",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "location",
            "in": "query",
            "description": "Filter by location (case-insensitive partial match)",
            "schema": {
              "type": "string"
            },
            "example": "Gangnam"
          },
          {
            "name": "verified",
            "in": "query",
            "description": "Filter by verified status",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "specialties",
            "in": "query",
            "description": "Comma-separated list of specialties to filter by",
            "schema": {
              "type": "string"
            },
            "example": "Rhinoplasty,Botox"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "clinics": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Clinic"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/clinics/{id}": {
      "get": {
        "tags": ["Clinics"],
        "summary": "Get clinic by ID",
        "description": "Retrieve detailed information about a specific clinic, including treatments offered",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Clinic ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "clinic": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Clinic"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "treatments": {
                              "type": "array",
                              "items": {
                                "allOf": [
                                  {
                                    "$ref": "#/components/schemas/Treatment"
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "price": {
                                        "type": "integer"
                                      },
                                      "availability": {
                                        "type": "string"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": ["Search"],
        "summary": "Search treatments and clinics",
        "description": "Search for treatments and clinics by name or description",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query string",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "example": "botox"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results per category",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "treatments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Treatment"
                      }
                    },
                    "clinics": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Clinic"
                      }
                    },
                    "query": {
                      "type": "string",
                      "description": "The search query that was executed"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/saved": {
      "get": {
        "tags": ["Saved Items"],
        "summary": "Get user's saved items",
        "description": "Retrieve all saved treatments and clinics for the authenticated user",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "savedItems": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SavedItem"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": ["Saved Items"],
        "summary": "Save a treatment or clinic",
        "description": "Add a treatment or clinic to the user's saved items",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["itemType", "itemId"],
                "properties": {
                  "itemType": {
                    "type": "string",
                    "enum": ["clinic", "treatment"],
                    "description": "Type of item to save"
                  },
                  "itemId": {
                    "type": "string",
                    "description": "ID of the treatment or clinic"
                  },
                  "notes": {
                    "type": "string",
                    "description": "Optional notes about this saved item"
                  }
                }
              },
              "example": {
                "itemType": "treatment",
                "itemId": "cmi2vbsbg000g7p8eoywt8baa",
                "notes": "Interested in this for next month"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "savedItem": {
                      "$ref": "#/components/schemas/SavedItem"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "Item already saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/saved/{id}": {
      "delete": {
        "tags": ["Saved Items"],
        "summary": "Remove a saved item",
        "description": "Delete a saved treatment or clinic from the user's saved items",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Saved item ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Saved item deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Treatment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "name": {
            "type": "string",
            "description": "Treatment name"
          },
          "slug": {
            "type": "string",
            "description": "URL-friendly identifier"
          },
          "description": {
            "type": "string",
            "description": "Detailed description"
          },
          "icon": {
            "type": "string",
            "nullable": true,
            "description": "Icon name"
          },
          "priceMin": {
            "type": "integer",
            "nullable": true,
            "description": "Minimum price in KRW"
          },
          "priceMax": {
            "type": "integer",
            "nullable": true,
            "description": "Maximum price in KRW"
          },
          "currency": {
            "type": "string",
            "nullable": true,
            "default": "KRW",
            "description": "Currency code"
          },
          "duration": {
            "type": "string",
            "nullable": true,
            "description": "Treatment duration"
          },
          "recoveryTime": {
            "type": "string",
            "nullable": true,
            "description": "Expected recovery time"
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of potential risks"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Treatment categories"
          },
          "beforeAfterImages": {
            "type": "object",
            "nullable": true,
            "description": "Before/after images"
          },
          "suitableFor": {
            "type": "object",
            "nullable": true,
            "description": "Suitability information"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Clinic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "name": {
            "type": "string",
            "description": "Clinic name"
          },
          "slug": {
            "type": "string",
            "description": "URL-friendly identifier"
          },
          "location": {
            "type": "string",
            "nullable": true,
            "description": "Location/district"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "description": "Full address"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Clinic description"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "Main image URL"
          },
          "rating": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "description": "Average rating"
          },
          "reviewCount": {
            "type": "integer",
            "nullable": true,
            "description": "Number of reviews"
          },
          "specialties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Clinic specialties"
          },
          "kakaoMapLink": {
            "type": "string",
            "nullable": true,
            "description": "Kakao Map link"
          },
          "verified": {
            "type": "boolean",
            "default": false,
            "description": "Verification status"
          },
          "priceLevel": {
            "type": "integer",
            "nullable": true,
            "description": "Price level (1-3)"
          },
          "openingHours": {
            "type": "object",
            "nullable": true,
            "description": "Opening hours by day"
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true,
            "description": "Contact phone number"
          },
          "websiteUrl": {
            "type": "string",
            "nullable": true,
            "description": "Website URL"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Photo URLs"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SavedItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "userId": {
            "type": "string",
            "description": "User ID"
          },
          "itemType": {
            "type": "string",
            "enum": ["clinic", "treatment"],
            "description": "Type of saved item"
          },
          "itemId": {
            "type": "string",
            "description": "ID of the saved treatment or clinic"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "User notes"
          },
          "savedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the item was saved"
          },
          "treatment": {
            "$ref": "#/components/schemas/Treatment",
            "description": "Populated treatment data (if itemType is treatment)"
          },
          "clinic": {
            "$ref": "#/components/schemas/Clinic",
            "description": "Populated clinic data (if itemType is clinic)"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Current page number"
          },
          "limit": {
            "type": "integer",
            "description": "Items per page"
          },
          "total": {
            "type": "integer",
            "description": "Total number of items"
          },
          "totalPages": {
            "type": "integer",
            "description": "Total number of pages"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "details": {
            "type": "object",
            "description": "Additional error details"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Validation failed",
              "details": [
                {
                  "path": "page",
                  "message": "Expected number, received string"
                }
              ]
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Resource not found"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Internal server error"
            }
          }
        }
      }
    }
  }
}
