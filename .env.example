# Environment variables template
# Copy this file to .env and fill in the values

# ============================================
# Phase 2: Database Configuration (Neon PostgreSQL)
# ============================================

# Neon PostgreSQL connection string (pooled connection for Prisma Client queries)
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
# Get this from your Neon project dashboard under "Connection Details"
DATABASE_URL="postgresql://user:password@host.neon.tech/pome?sslmode=require"

# Direct database connection (non-pooled, used for Prisma migrations)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Get this from your Neon project dashboard under "Connection Details" (Direct connection)
DIRECT_URL="postgresql://user:password@host.neon.tech:5432/pome"

# Application base URL (used for API calls from frontend)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Phase 3: Authentication (NextAuth.js)
# ============================================

# NextAuth.js configuration
# Base URL for your application (used for redirects and callbacks)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# NextAuth secret for signing JWTs and encrypting session tokens
# IMPORTANT: Generate a secure random string with: openssl rand -base64 32
# NEVER use the same secret in development and production!
NEXTAUTH_SECRET="your-nextauth-secret-here-replace-with-generated-value"

# ============================================
# Phase 3: Email Service (Resend)
# ============================================

# Resend API key for sending transactional emails (password resets, etc.)
# Get your API key from: https://resend.com/api-keys
# Sign up for free tier at: https://resend.com/signup
RESEND_API_KEY="re_123456789_your_resend_api_key_here"

# Email sender address
# Development: Use Resend's test domain (no verification needed)
#   - Set to: onboarding@resend.dev
#   - Emails will be delivered normally for testing
# Production: Use your verified domain
#   - Must verify your domain in Resend dashboard first
#   - Add DNS records (SPF, DKIM, DMARC) as shown in Resend dashboard
#   - Format: "Your App Name <noreply@yourdomain.com>"
#   - Example: "Pome <noreply@pome.com>"
EMAIL_FROM="onboarding@resend.dev"

# ============================================
# Phase 4+: External APIs
# ============================================

# Kakao Map API key for location services
# KAKAO_MAP_API_KEY=
